PORT=3000
JWT_SECRET=your_jwt_secret_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here
AUDIUS_API_KEY=your_audius_api_key_here

# Google Gemini AI Recommender (Step 1-6)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_RECOMMENDER_ENABLED=true
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=3000

# Stage 3B: Supabase Development Database (Development Only)
# Default is 'sqlite' for zero disruption to production
DATABASE_BACKEND=sqlite
SUPABASE_DEV_URL=https://your-dev-project.supabase.co
SUPABASE_DEV_ANON_KEY=your_dev_anon_key_here
SUPABASE_DEV_SERVICE_ROLE_KEY=your_dev_service_role_key_here
